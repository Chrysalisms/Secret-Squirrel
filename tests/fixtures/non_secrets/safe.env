# Safe non-secrets fixture — should produce ZERO findings
# These are example/placeholder values, not real credentials

# Environment configuration (development)
APP_NAME=my-application
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=debug

# Database (example connection string with placeholder values)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp_dev
DB_USER=developer
DB_PASSWORD=changeme
DATABASE_URL=postgresql://developer:changeme@localhost:5432/myapp_dev

# Feature flags
FEATURE_DARK_MODE=true
FEATURE_BETA=false
MAX_CONNECTIONS=10
TIMEOUT_SECONDS=30

# URLs
API_BASE_URL=https://api.example.com
WEBHOOK_URL=https://webhook.example.com/events
STATIC_ASSETS_URL=https://cdn.example.com/assets

# Non-secret config
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
MAIL_FROM=noreply@example.com
