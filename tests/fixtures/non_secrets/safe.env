# Non-secrets fixture — used to verify no false positives
# All values here should NOT trigger secret detection

# Environment variables with non-secret values
DATABASE_NAME=myapp
APP_NAME=secret-squirrel
LOG_LEVEL=info
PORT=3000

# High-entropy but not secrets (random hashes used legitimately)
CONTENT_HASH=sha256:a948904f2f0f479b8f936aab6b8f04b8f12b3f81fe1fd0a9c6b3e4d7f2a5b8c9
CHECKSUM=abc123def456abc123def456abc123def456

# URL examples (not credentials)
BASE_URL=https://api.example.com
WEBHOOK_URL=https://hooks.example.com/webhook/receive

# Common placeholder values that should be ignored
SECRET_KEY=changeme
PASSWORD=PLACEHOLDER
API_KEY=your-api-key-here
TOKEN=example-token

# Test/example strings clearly marked as fake
TEST_GITHUB_TOKEN=ghp_EXAMPLE_FAKE_TOKEN_NOT_REAL_1234567
FAKE_AWS_KEY=FAKEKEYNOTREAL123456

# Long random-looking strings that are actually content IDs
CACHE_KEY=content-1234567890abcdef1234567890abcdef
ETAG="33a64df551425fcc55e4d42a148795d9f25f89d4"

# Comments mentioning credentials (documentation context)
# The AWS access key format is: AKIA[0-9A-Z]{16}
# Example: AKIAIOSFODNN7EXAMPLE (this is NOT a real key)
