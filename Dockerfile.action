# ============================================================
# Dockerfile.action — Secret Squirrel GitHub Action image
# ============================================================
#
# Multi-stage build:
#   Stage 1 (build)   — compiles squirrel with github-action features
#   Stage 2 (runtime) — minimal debian runtime image
#
# Usage in action.yml:
#   runs:
#     using: "docker"
#     image: "Dockerfile.action"

# ────────────────────────────────────────────────────────────
# Stage 1: Build
# ────────────────────────────────────────────────────────────
FROM rust:1.75-slim AS build

# Install build-time system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    libgit2-dev \
    cmake \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Cache dependency layer: copy manifests first, then source
# This means changes to src/ don't invalidate the dep-fetch layer.
COPY Cargo.toml Cargo.lock ./

# Create stub lib/main so `cargo fetch` succeeds without full source
RUN mkdir -p src && \
    echo "fn main() {}" > src/main.rs && \
    echo "" > src/lib.rs && \
    cargo fetch --locked

# Copy the full source tree and rules
COPY src/ ./src/
COPY rules/ ./rules/

# Compile with the github-action feature set:
#   - mcp-server  — MCP server for AI agent integration
#   - github-action — CNN classifier + action-specific tweaks
# Release profile: lto=fat, strip=true (configured in Cargo.toml)
RUN cargo build --release --locked \
    --no-default-features \
    --features github-action \
    2>&1 | tee /build/build.log

# Verify the binary exists and is healthy
RUN /build/target/release/squirrel --version

# ────────────────────────────────────────────────────────────
# Stage 2: Runtime
# ────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

# Install runtime dependencies only (no build tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    libgit2-1.5 \
    git \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user for the action
RUN groupadd --gid 1001 squirrel && \
    useradd --uid 1001 --gid squirrel --shell /bin/sh --create-home squirrel

WORKDIR /action

# Copy the compiled binary from the build stage
COPY --from=build /build/target/release/squirrel /usr/local/bin/squirrel

# Copy the entrypoint script
COPY entrypoint.sh /action/entrypoint.sh
RUN chmod +x /action/entrypoint.sh

# Ensure the binary is accessible
RUN squirrel --version

# ── Health check ─────────────────────────────────────────────
HEALTHCHECK --interval=30s --timeout=5s --start-period=2s --retries=3 \
    CMD squirrel --version || exit 1

# Switch to non-root user for execution
USER squirrel

ENTRYPOINT ["/action/entrypoint.sh"]
